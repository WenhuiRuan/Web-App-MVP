# Backend only. Optional: copy to .env; process environment takes precedence.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_PATH=local-data/panel.sqlite3
LOG_LEVEL=INFO

# Explicit deterministic mock; it never contacts a model service.
# DeepSeek: set MODEL_PROVIDER=deepseek, MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash and MODEL_API_KEY=${PANEL_API_KEY}.
# PANEL_API_KEY must be inherited by the backend process; never put it in frontend env.
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
# Applies to all six DeepSeek tasks; mock ignores these settings.
# Only final content is consumed; reasoning_content is never retained.
MODEL_THINKING_MODE=enabled
MODEL_REASONING_EFFORT=low
MODEL_THINKING_MAX_TOKENS=16384
MODEL_MAX_CONCURRENCY=4
MODEL_MAX_ATTEMPTS=2

# Capacity now applies to GENERATING/RUNNING/SUMMARIZING discussions.
# Turn/time limits are frozen on run creation; start schedules the run automatically.
DISCUSSION_MAX_ACTIVE=3
DISCUSSION_MAX_TURNS=20
DISCUSSION_MAX_SECONDS=300
SUMMARY_MAX_SECONDS=60
INSIGHT_MAX_SECONDS=15
# For DeepSeek enabled/low, start with these finite process overrides and measure:
# MODEL_TIMEOUT_SECONDS=120, DISCUSSION_MAX_SECONDS=600,
# INSIGHT_MAX_SECONDS=240, SUMMARY_MAX_SECONDS=180.
# Multi-step insights/summary use per-HTTP timeout plus one shared task deadline.
# These overrides still require final full real-model quality validation.
# Short defaults above remain suitable for the deterministic mock / disabled mode.
