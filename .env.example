# Backend only. Optional: copy to .env; process environment takes precedence.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_PATH=local-data/panel.sqlite3
LOG_LEVEL=INFO

# Explicit deterministic mock; it never contacts a model service.
# Other providers are reserved for a later adapter and report not ready now.
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_CONCURRENCY=4
MODEL_MAX_ATTEMPTS=2

# Capacity now applies to GENERATING/RUNNING/SUMMARIZING discussions.
# Turn/time limits are frozen on run creation; automatic scheduling comes later.
DISCUSSION_MAX_ACTIVE=3
DISCUSSION_MAX_TURNS=20
DISCUSSION_MAX_SECONDS=300
SUMMARY_MAX_SECONDS=60
